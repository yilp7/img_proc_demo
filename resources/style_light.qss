/* ============================================================
 * GLI User Panel - Light Theme (prototype v3)
 * Theme template: token placeholders are resolved at runtime.
 * ============================================================
 *
 * Color tokens (prototype.html v3 :root)
 *
 * Surfaces
 *   bg-deepest    ${bg-deepest}    bg-base       ${bg-base}
 *   bg-raised     ${bg-raised}    bg-elevated   ${bg-elevated}
 *   bg-header     ${bg-header}    bg-header-end ${bg-raised}
 *   bg-active     ${bg-active}
 *
 * Borders
 *   border-subtle ${border-subtle}    border-default ${border-default}
 *   border-strong ${border-strong}
 *
 * Text
 *   text-primary   ${text-primary}   text-secondary ${text-secondary}
 *   text-muted     ${text-muted}   text-dim       ${text-dim}
 *   text-ghost     ${text-ghost}
 *
 * Accent
 *   accent ${accent}   accent-muted ${accent-muted}
 *   accent-glow-33 ${accent-glow-33}
 *
 * Semantic
 *   positive ${positive}   negative ${negative}
 *   info     ${info}   warning  ${warning}
 *   readout  ${readout}
 *
 * Misc
 *   slider-thumb ${accent}   slider-track ${slider-track}
 *   crosshair    ${crosshair}   shadow       ${shadow}
 * ============================================================ */

/* === Base ============================================== */
QMainWindow {
    background-color: ${bg-base};
    color: ${text-secondary};
}

#Distance3DView {
    background-color: ${bg-base};
    color: ${text-secondary};
}

/* Baseline rule for plain QWidget / QFrame instances (matches only
   exact class, not subclasses). Keeps re-parented .ui-designed
   QFrames (e.g. Preferences sub-groups) from showing the system
   palette through. Subclass-specific rules below override per id. */
.QWidget {
    background-color: ${bg-raised};
    color: ${text-secondary};
}

.QFrame {
    background-color: ${bg-raised};
    color: ${text-secondary};
}

/* === TopBar action cluster (preserved icon assets) ====== */
#NAME, #APP_NAME {
    image: url(:/title/GLI_light);
}

#ADDON_BTN            { image: url(:/tools/light/addon); }
#ADDON_BTN::hover,
#ADDON_BTN::pressed   { image: url(:/tools/light/addon_hover); }

#URL_BTN              { image: url(:/tools/light/url); }
#URL_BTN::hover,
#URL_BTN::pressed     { image: url(:/tools/light/url_hover); }

#SETTINGS_BTN         { image: url(:/tools/light/settings); }
#SETTINGS_BTN::hover,
#SETTINGS_BTN::pressed{ image: url(:/tools/light/settings_hover); }

#CAPTURE_BTN          { image: url(:/tools/light/capture); }
#CAPTURE_BTN::hover,
#CAPTURE_BTN::pressed { image: url(:/tools/light/capture_hover); }

#LANGUAGE_BTN         { image: url(:/tools/light/lang); }

#CLS_BTN              { image: url(:/tools/light/brush); }
#CLS_BTN::hover,
#CLS_BTN::pressed     { image: url(:/tools/light/brush_hover); }

#COLOR_MODE_BTN            { image: url(:/tools/toggle_light); }
#COLOR_MODE_BTN::hover,
#COLOR_MODE_BTN::pressed   { image: url(:/tools/toggle_dark); }

#HIDE_BTN {
    padding: 2px;
    border: none;
    background-color: transparent;
}

#HIDE_BTN[hideDirection="left"] {
    image: url(:/tools/light/left);
}

#HIDE_BTN[hideDirection="right"] {
    image: url(:/tools/light/right);
}

/* === Menus ============================================= */
QMenuBar, QMenu {
    background-color: ${bg-elevated};
    color: ${text-secondary};
    border: 1px solid ${border-default};
}

QMenuBar::item:selected, QMenu::selected {
    background-color: ${bg-active};
    color: ${text-primary};
}

/* === Inputs ============================================ */
QLineEdit, QTextEdit, QPlainTextEdit, .QComboBox, QDialog {
    border: 1px solid ${border-subtle};
    background-color: ${bg-base};
    color: ${readout};
    selection-background-color: ${accent-glow-33};
    selection-color: ${text-primary};
    border-radius: 2px;
}

QLineEdit::disabled, QTextEdit::disabled,
QPlainTextEdit::disabled, .QComboBox::disabled {
    background-color: ${bg-raised};
    color: ${text-dim};
}

QLineEdit::focus, QTextEdit::focus,
QPlainTextEdit::focus, .QComboBox::focus {
    border: 1px solid ${accent-glow-33};
}

/* === ComboBox ========================================== */
.QComboBox::drop-down {
    image: url(:/tools/light/triangle);
    width: 12px;
    height: 12px;
    margin-top: 2px;
    margin-left: 2px;
    background-color: ${bg-elevated};
    border-radius: 2px;
}

.QComboBox::on {
    border: 1px solid ${accent-glow-33};
}

.QComboBox::drop-down:disabled,
.QComboBox::drop-down:hover {
    background-color: ${bg-active};
}

.QComboBox::drop-down:on {
    background-color: ${border-default};
}

.QComboBox QAbstractItemView {
    background-color: ${bg-elevated};
    selection-background-color: ${bg-active};
    color: ${text-secondary};
    selection-color: ${text-primary};
    border: 1px solid ${border-default};
    border-radius: 2px;
    outline: 0px;
}

MiscSelection {
    border: none;
    background-color: ${bg-raised};
    color: ${text-secondary};
    width: 60px;
}

MiscSelection QAbstractItemView {
    background-color: ${bg-elevated};
    selection-background-color: ${bg-active};
    color: ${text-secondary};
    selection-color: ${text-primary};
    border-radius: 2px;
    outline: 0px;
}

/* === Labels and frames ================================= */
.QLabel {
    color: ${text-secondary};
    background: transparent;
}

Display {
    border: 1px solid ${border-default};
    background-color: ${bg-deepest};
}

#FPS_LABEL {
    color: ${text-primary};
    background-color: ${shadow};
    padding: 1px 4px;
    border-radius: 2px;
}

#SOURCE_DEAD_LABEL {
    color: ${negative};
    background-color: ${shadow};
    padding: 1px 4px;
    border-radius: 2px;
}

#MONITOR_CUSTOM_TITLE {
    color: ${text-primary};
    background-color: ${shadow};
    padding: 8px 40px;
    border-radius: 2px;
}

QLabel[portState="connected"] {
    color: ${text-primary};
}

QLabel[portState="error"] {
    color: ${negative};
}

QLabel[portNetwork="true"] {
    text-decoration: underline;
}

#FISHNET_RESULT[fishnetState="neutral"] {
    color: ${text-secondary};
}

#FISHNET_RESULT[fishnetState="alert"] {
    color: ${negative};
}

Ruler {
    color: ${text-dim};
}

/* === Group box ========================================= */
/* Flat - matches plain-QFrame look used by the re-parented Preferences
   groups in SETUP overlay. Title remains as accent-colored label. */
QGroupBox {
    color: ${text-primary};
    border: none;
    margin-top: 14px;
    padding-top: 0;
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    color: ${accent};
    background: transparent;
    padding: 0 4px;
    font-weight: 700;
}

/* Setup overlay card titles - small labels above Save/Comm/TCU/Device cards.
   Color-only; weight intentionally normal to match how QGroupBox::title
   actually renders (its font-weight: 700 doesn't bold the subcontrol). */
#SETUP_CARD_TITLE {
    color: ${accent};
    padding-left: 4px;
}

/* === Tabs ============================================== */
QTabWidget::pane {
    border: 1px solid ${border-default};
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: ${bg-raised};
}

QTabBar::tab {
    background-color: ${bg-raised};
    color: ${text-muted};
    min-width: 64px;
    height: 20px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border: 1px solid ${border-subtle};
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: ${bg-elevated};
    color: ${accent};
    border-color: ${border-default};
}

QTabBar::tab:hover {
    background-color: ${bg-active};
    color: ${text-secondary};
}

/* === Buttons =========================================== */
.QPushButton, .QToolButton {
    background-color: ${bg-raised};
    color: ${text-secondary};
    border: 1px solid ${border-default};
    border-radius: 2px;
    padding: 2px 6px;
}

.QPushButton::disabled, .QToolButton::disabled {
    background-color: ${bg-base};
    border: 1px solid ${border-subtle};
    color: ${text-dim};
}

.QPushButton::hover, .QToolButton::hover {
    background-color: ${bg-header};
    border: 1px solid ${border-strong};
    color: ${text-primary};
}

.QPushButton::pressed, .QToolButton::pressed {
    background-color: ${bg-active};
    color: ${accent};
}

.QPushButton:checked, .QToolButton:checked {
    background-color: ${bg-active};
    border: 1px solid ${accent};
    color: ${accent};
}

QPushButton::menu-indicator {
    image: none;
}

/* === Checkbox / Radio (icon assets preserved) ========== */
.QCheckBox, .QRadioButton {
    color: ${text-secondary};
    background: transparent;
}

.QCheckBox::disabled, .QRadioButton::disabled {
    color: ${text-dim};
}

.QCheckBox::indicator {
    width: 10px;
    height: 10px;
    border: 1px solid ${border-default};
    background-color: ${bg-base};
    border-radius: 2px;
}

.QRadioButton::indicator {
    width: 10px;
    height: 10px;
    border: 1px solid ${border-default};
    background-color: ${bg-base};
    border-radius: 7px;
}

.QCheckBox::indicator:checked   { image: url(:/tools/light/check); }
.QRadioButton::indicator:checked{ image: url(:/tools/light/dot); }

.QCheckBox::indicator:disabled,
.QRadioButton::indicator:disabled {
    background-color: ${bg-raised};
    border-color: ${border-subtle};
}

.QCheckBox::indicator:hover,
.QRadioButton::indicator:hover {
    background-color: ${bg-elevated};
    border-color: ${border-strong};
}

.QCheckBox::indicator:pressed,
.QRadioButton::indicator:pressed {
    background-color: ${bg-deepest};
}

/* === Slider ============================================ */
QSlider::groove:horizontal {
    height: 4px;
    background-color: ${slider-track};
    border: 1px solid ${border-subtle};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: ${accent};
    border: 1px solid ${border-strong};
    border-radius: 2px;
}

QSlider::handle:horizontal:hover {
    background-color: ${accent-hover};
    border: 1px solid ${accent};
}

QSlider::handle:horizontal:pressed {
    background-color: ${accent-muted};
}

QSlider::handle:horizontal:disabled {
    background-color: ${text-dim};
    border: 1px solid ${border-default};
}

QSlider::groove:vertical {
    width: 4px;
    background-color: ${slider-track};
    border: 1px solid ${border-subtle};
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: ${accent};
    border: 1px solid ${border-strong};
    border-radius: 2px;
}

QSlider::handle:vertical:hover {
    background-color: ${accent-hover};
}

#MCP_SLIDER::handle:horizontal,
#DELAY_SLIDER::handle:horizontal,
#GW_SLIDER::handle::horizontal,
#GAIN_SLIDER::handle:horizontal,
#PTZ_SPEED_SLIDER::handle:horizontal {
    width: 8px;
    height: 16px;
    margin-top: -6px;
    margin-bottom: -6px;
}

#BRIGHTNESS_SLIDER::handle:horizontal, #CONTRAST_SLIDER::handle:horizontal,
#GAMMA_SLIDER::handle:horizontal, #FOCUS_SPEED_SLIDER::handle:horizontal,
#SLIDER_SPEED_1::handle:horizontal, #SLIDER_SPEED_2::handle:horizontal,
#SLIDER_SPEED_3::handle:horizontal, #SLIDER_SPEED_4::handle:horizontal {
    width: 6px;
    height: 8px;
    margin-top: -2px;
    margin-bottom: -2px;
}

/* === Tools (display image overlay) ===================== */
Tools {
    background-color: ${bg-raised};
    border: 1px solid ${border-subtle};
    border-radius: 2px;
}

#ZOOM_TOOL::indicator,
#SELECT_TOOL::indicator,
#PTZ_TOOL::indicator {
    width: 16px;
    height: 16px;
    /* QRadioButton anchors ::indicator left-of-text by default; with no
       text the indicator still hugs the left edge. Force center. */
    subcontrol-position: center;
}

#ZOOM_TOOL::indicator   { image: url(:/tools/dark/move); }
#SELECT_TOOL::indicator { image: url(:/tools/dark/select); }
#PTZ_TOOL::indicator    { image: url(:/tools/dark/ptz); }

Tools::checked { background-color: ${bg-active}; border-color: ${accent-glow-33}; }
Tools::hover   { background-color: ${bg-header}; }

/* === Coordinate / info labels ========================== */
Coordinate InfoLabel {
    color: ${text-primary};
}

/* === Spin box ========================================== */
QSpinBox {
    padding-right: 12px;
    border: 1px solid ${border-subtle};
    background-color: ${bg-base};
    color: ${readout};
    selection-background-color: ${accent-glow-33};
    selection-color: ${text-primary};
    border-radius: 2px;
}

QSpinBox::focus {
    border: 1px solid ${accent-glow-33};
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 12px;
    margin-right: 3px;
    image: url(:/tools/light/up);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 12px;
    image: url(:/tools/light/down);
    margin-right: 16px;
}

/* === Scroll area ======================================= */
QScrollArea, #CONTENT {
    border: none;
    background-color: ${bg-base};
    color: ${text-secondary};
}

IndexLabel {
    color: ${text-secondary};
}

IndexLabel::hover {
    color: ${text-primary};
    text-decoration: line-through;
}

#SCAN_CONFIG_BTN {
    background-color: transparent;
    border-style: none;
    image: url(:/tools/light/settings_hover);
    padding: 2px;
}

#SCAN_CONFIG_BTN::hover, #SCAN_CONFIG_BTN::pressed {
    background-color: transparent;
    border-style: none;
    image: url(:/tools/light/settings_hover);
    padding: 0px;
}

/* === ScrollBar ========================================= */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    padding: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    padding: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
    border-radius: 4px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: ${border-default};
    border: none;
    border-radius: 4px;
    min-height: 16px;
    min-width: 16px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: ${border-strong};
}

QScrollBar::sub-line, QScrollBar::add-line {
    height: 0px;
    width: 0px;
    background: transparent;
}

/* === Aliasing / table view ============================= */
QTableView {
    background-color: ${bg-base};
    color: ${text-primary};
    border: 1px solid ${border-default};
    gridline-color: ${border-default};
    alternate-background-color: ${bg-raised};
    selection-color: ${text-primary};
    selection-background-color: ${bg-active};
}

QTableView::item:!alternate:!selected {
    background-color: ${bg-base};
}

QHeaderView::section {
    background-color: ${bg-elevated};
    color: ${accent};
    padding-left: 4px;
    border: 1px solid ${border-default};
    min-height: 24px;
}

/* === Tooltip =========================================== */
QToolTip {
    background-color: ${bg-header};
    color: ${text-primary};
    border: 1px solid ${border-strong};
    padding: 2px 4px;
}

/* ============================================================
 * Sprint 20.2 - custom widgets
 * ============================================================ */

/* === TopBar shell ====================================== */
#TOP_BAR {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 ${bg-header}, stop:1 ${bg-elevated});
    border-bottom: 1px solid ${border-default};
}

/* TopButton - QPushButton subclass for the action cluster + window
   controls. The `image: url(...)` rules above place the icon; here we
   keep the button itself transparent + borderless so the icon shows
   on the TopBar gradient. (The legacy QSS had the equivalent rule
   under the now-removed TitleButton selector.) */
TopButton {
    background-color: transparent;
    border: none;
    padding: 0;
}

TopButton:hover {
    background-color: transparent;
}

TopButton:pressed {
    background-color: transparent;
}

#ADDON_BTN, #URL_BTN, #SETTINGS_BTN, #CAPTURE_BTN,
#CLS_BTN, #LANGUAGE_BTN, #COLOR_MODE_BTN,
#ADDON_BTN::hover, #URL_BTN::hover, #SETTINGS_BTN::hover, #CAPTURE_BTN::hover,
#CLS_BTN::hover, #LANGUAGE_BTN::hover, #COLOR_MODE_BTN::hover,
#ADDON_BTN::pressed, #URL_BTN::pressed, #SETTINGS_BTN::pressed, #CAPTURE_BTN::pressed,
#CLS_BTN::pressed, #LANGUAGE_BTN::pressed, #COLOR_MODE_BTN::pressed {
    background-color: transparent;
    border: none;
}

#MIN_BTN, #MAX_BTN, #EXIT_BTN {
    background-color: transparent;
    border: none;
    padding: 7px 12px;
}

#MIN_BTN::hover, #MAX_BTN::hover {
    background-color: ${bg-header};
    border: none;
}

#MIN_BTN::pressed, #MAX_BTN::pressed {
    background-color: ${border-default};
    border: none;
}

#EXIT_BTN::hover {
    background-color: #CD5C5C;
    border: none;
}

#EXIT_BTN::pressed {
    background-color: #BD4C4C;
    border: none;
}

#TOP_BAR_LEFT, #TOP_BAR_CENTER, #TOP_BAR_RIGHT, #TOP_WINDOW_CONTROLS {
    background: transparent;
}

#TOP_BAR_CLOCK {
    color: ${readout};
    font-family: Consolas;
    font-size: 11px;
    background: transparent;
}

#PIXEL_DEPTH_LABEL, #RESOLUTION_LABEL {
    color: ${text-muted};
    background: transparent;
    font-size: 10px;
}

DotIndicator {
    qproperty-offColor: ${border-subtle};
    qproperty-okColor: ${positive};
    qproperty-warnColor: ${accent};
    qproperty-errColor: ${negative};
}

#SYSTEM_SELECTOR {
    background-color: ${bg-elevated};
    color: ${text-secondary};
    border: 1px solid ${border-default};
    border-radius: 2px;
    padding: 0 6px;
    min-height: 20px;
    max-height: 22px;
}

/* mode tabs (SETUP / MONITOR / SCAN) */
#MODE_SETUP, #MODE_MONITOR, #MODE_SCAN {
    background-color: ${bg-elevated};
    color: ${text-dim};
    border: 1px solid ${border-subtle};
    padding: 3px 12px;
    font-weight: 700;
    font-size: 10px;
}

#MODE_SETUP:hover, #MODE_MONITOR:hover, #MODE_SCAN:hover {
    background-color: ${bg-active};
    color: ${text-secondary};
}

#MODE_SETUP:checked, #MODE_MONITOR:checked, #MODE_SCAN:checked {
    background-color: ${bg-active};
    color: ${accent};
    border: 1px solid ${accent};
}

/* === FloatingPanel base ================================ */
#FloatingPanel {
    background-color: ${bg-raised};
    border: 1px solid ${border-default};
    border-radius: 3px;
}

#FloatingPanelHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 ${bg-header}, stop:1 ${bg-raised});
    border-bottom: 1px solid ${border-default};
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

#FloatingPanelTitle {
    color: ${accent};
    font-weight: 700;
    font-size: 10px;
    background: transparent;
    padding-left: 2px;
}

#FloatingPanelPin, #FloatingPanelHide, #FloatingPanelReset {
    background-color: transparent;
    color: ${text-muted};
    border: none;
    border-radius: 2px;
    font-size: 9px;
}

#FloatingPanelPin:hover, #FloatingPanelHide:hover, #FloatingPanelReset:hover {
    background-color: ${bg-active};
    color: ${text-primary};
}

#FloatingPanelPin:checked {
    background-color: ${bg-active};
    color: ${accent};
}

#FloatingPanelHide:hover {
    background-color: ${negative-hover-bg};
    color: ${negative};
}

#FLOATING_WINDOW_CHROME {
    background-color: transparent;
    border: none;
}

#FLOATING_WINDOW_EXIT {
    background-color: transparent;
    border: none;
    padding: 0px;
}

#FLOATING_WINDOW_EXIT:hover {
    background-color: ${negative-hover-bg};
}

#PANORAMA_RESIZE_HANDLE, #ADDON_RESIZE_HANDLE {
    background-color: transparent;
    border-right: 2px solid ${text-muted};
    border-bottom: 2px solid ${text-muted};
}

#PANORAMA_RESIZE_HANDLE:hover, #ADDON_RESIZE_HANDLE:hover {
    background-color: ${bg-active};
    border-right: 2px solid ${accent};
    border-bottom: 2px solid ${accent};
}

#PANORAMA_STATUS {
    color: ${text-muted};
    font-size: 9px;
    font-weight: 700;
    background: transparent;
    padding-right: 2px;
}

#PANORAMA_SCROLL {
    background-color: ${bg-deepest};
    border: none;
}

#PANORAMA_PREVIEW {
    background-color: ${bg-deepest};
    border: none;
}

#ADDON_PLUGIN_HOST {
    background-color: ${bg-deepest};
    border: none;
}

/* OpticsPanel / TCUPanel mode toggles - Classic/Modern, Normal/Guru */
#OPTICS_CLASSIC_BTN, #OPTICS_MODERN_BTN,
#TCU_NORMAL_BTN, #TCU_GURU_BTN {
    background-color: ${bg-raised};
    color: ${text-dim};
    border: 1px solid ${border-subtle};
    border-radius: 2px;
    padding: 2px 8px;
    font-size: 9px;
    font-weight: 700;
}

#OPTICS_CLASSIC_BTN:hover, #OPTICS_MODERN_BTN:hover,
#TCU_NORMAL_BTN:hover, #TCU_GURU_BTN:hover {
    background-color: ${bg-active};
    color: ${text-secondary};
}

#OPTICS_CLASSIC_BTN:checked, #OPTICS_MODERN_BTN:checked,
#TCU_NORMAL_BTN:checked, #TCU_GURU_BTN:checked {
    background-color: ${bg-active};
    color: ${accent};
    border: 1px solid ${accent};
}

/* === Center display toolbar (SEL / ZOOM / PTZ + INFO) === */
/* Transparent container so the chip-style Tools buttons sit cleanly over
   the display; the warm-border outline used to read cool/blue against the
   surrounding panels. Matches PANEL_TOGGLE_BAR. */
#CENTER_TOOLBAR {
    background: transparent;
    border: none;
}

/* === Pbar (panel-toggle bar) =========================== */
/* Transparent container so the buttons read as a chip cluster, not as a
   "box inserted into the panel". Each button still has its own border. */
#PANEL_TOGGLE_BAR {
    background: transparent;
    border: none;
}

#PBAR_OPTICS_BTN, #PBAR_TCU_BTN, #PBAR_CONSOLE_BTN {
    background-color: ${bg-raised};
    color: ${text-muted};
    border: 1px solid ${border-subtle};
    border-radius: 2px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

#PBAR_OPTICS_BTN:hover, #PBAR_TCU_BTN:hover, #PBAR_CONSOLE_BTN:hover {
    background-color: ${bg-active};
    color: ${text-secondary};
}

#PBAR_OPTICS_BTN:checked, #PBAR_TCU_BTN:checked, #PBAR_CONSOLE_BTN:checked {
    background-color: ${bg-active};
    color: ${accent};
    border: 1px solid ${accent};
}

/* === Right-side widget stack =========================== */
#RIGHT_STACK {
    background-color: ${bg-raised};
    border: 1px solid ${border-subtle};
    border-radius: 3px;
}

#IMG_PROC_WIDGET, #PTZ_RADAR_WIDGET, #SAVE_OPTIONS_WIDGET, #VISION_WIDGET {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid ${border-subtle};
}

#VISION_WIDGET { border-bottom: none; }

#VISION_ROW_MAIN, #VISION_ROW_ALT1, #VISION_ROW_ALT2 {
    background-color: transparent;
    border: none;
}

#PTZ_RADAR_WIDGET {
    qproperty-radarBackgroundColor: ${bg-deepest};
    qproperty-radarBorderColor: ${border-subtle};
    qproperty-radarGridColor: ${border-default};
    qproperty-radarGridSoftColor: ${border-subtle};
    qproperty-radarTextColor: ${text-secondary};
    qproperty-radarMutedColor: ${text-muted};
    qproperty-radarAccentColor: ${accent};
}

/* === Side zone (SideDisplay + Mapbox) ================== */
#SIDE_DISPLAY_WIDGET, #MAPBOX_WIDGET {
    background-color: ${bg-deepest};
    border: 1px solid ${border-subtle};
    border-radius: 3px;
}

#SIDE_DISPLAY_PLACEHOLDER, #MAPBOX_PLACEHOLDER {
    color: ${text-dim};
    background: transparent;
    font-size: 10px;
}

#SIDE_DISPLAY_SECTION_LBL, #PREVIEW_THUMB_LBL {
    color: ${accent};
    background: transparent;
    font-weight: 700;
}

#SIDE_DISPLAY_THUMB, #PREVIEW_THUMB {
    background-color: ${bg-deepest};
    border: 1px solid ${border-subtle};
}

#SIDE_DISPLAY_SWAP_BTN {
    background-color: ${side-action-bg};
    border: 1px solid ${border-default};
    border-radius: 3px;
    padding: 0px;
}

#SIDE_DISPLAY_SWAP_BTN:hover {
    background-color: ${side-action-hover-bg};
    border-color: ${text-dim};
}

#SIDE_DISPLAY_SWAP_BTN:pressed {
    background-color: ${side-action-pressed-bg};
}

/* === SETUP overlay ===================================== */
#SETUP_OVERLAY {
    background-color: ${bg-base};
    border: none;
}

#SETUP_SCROLL {
    background-color: transparent;
    border: none;
}

#SETUP_ROW_1, #SETUP_ROW_2, #SETUP_ROW_3 {
    background-color: transparent;
}

#SETUP_PREVIEW_SIDEBAR {
    background-color: ${bg-raised};
    border: 1px solid ${border-subtle};
    border-radius: 3px;
}

#SETUP_PREVIEW_PLACEHOLDER {
    color: ${text-dim};
    background: transparent;
}

/* === SCAN overlay ====================================== */
#SCAN_OVERLAY {
    background-color: ${bg-base};
    border: none;
}

#SCAN_SCROLL {
    background-color: transparent;
    border: none;
}

/* group cards */
#SCAN_CARD {
    background-color: ${bg-raised};
    border: 1px solid ${border-default};
    border-radius: 3px;
}

#SCAN_CARD_TTL {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 ${bg-header}, stop:1 ${bg-raised});
    border-bottom: 1px solid ${border-default};
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-height: 22px;
    max-height: 22px;
}

#SCAN_CARD_TTL > QLabel {
    color: ${accent};
    font-weight: 700;
    font-size: 10px;
    background: transparent;
}

#SCAN_CARD_BODY {
    background-color: ${bg-raised};
    border: none;
}

/* Separator line inside scan card bodies - prototype `.guru-sep`.
   Replaces QFrame::HLine palette rendering with token-driven color. */
#SCAN_CARD_SEP {
    background-color: ${bg-header};
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* action column - Start (positive) / Continue / Restart / Stop (negative) */
#SCAN_ACTION_COL {
    background-color: transparent;
}

#SCAN_ACTION_COL > QPushButton {
    background-color: ${bg-raised};
    color: ${text-muted};
    border: 1px solid ${border-default};
    border-radius: 3px;
    padding: 6px 0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
}

#SCAN_ACTION_COL > QPushButton:hover {
    background-color: ${bg-header};
    color: ${text-secondary};
    border-color: ${border-strong};
}

/* SCAN_BUTTON dual state - start (positive-green) vs running (warning-amber).
   The `scanning` dynamic property is set in userpanel.cpp's lambda hooked to
   ScanController::scan_button_text_changed. QSS attribute selectors pick up
   the value after unpolish + polish. */
#SCAN_ACTION_COL > #SCAN_BUTTON {
    background-color: ${positive-bg};        /* positive-bg */
    color: ${readout};                   /* readout */
    border: 1px solid ${positive-border};        /* positive-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON:hover {
    background-color: ${positive-hover-bg};        /* positive-hover-bg */
    color: ${positive-hover-text};                   /* positive-hover-text */
    border: 1px solid ${positive-hover-border};        /* positive-hover-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON[scanning="true"] {
    background-color: ${warning-bg};        /* warning-bg */
    color: ${warning-hover-text};                   /* warning-hover-text */
    border: 1px solid ${warning-border};        /* warning-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON[scanning="true"]:hover {
    background-color: ${warning-hover-bg};        /* warning-hover-bg */
    color: ${warning};                   /* warning */
    border: 1px solid ${warning-hover-border};        /* warning-hover-border */
}

/* === SCAN preview sidebar ============================== */
#SCAN_PREVIEW_SIDEBAR {
    background-color: ${bg-raised};
    border: 1px solid ${border-subtle};
    border-radius: 3px;
}

#SCAN_PREVIEW_PH {
    color: ${text-dim};
    background: transparent;
}

/* === Modern PTZ labels (joystick + arc sliders) ======== */
#JoyLabel {
    font-size: 9px;
    color: ${text-dim};             /* text-dim */
    background: transparent;
}

#ArcLabel {
    font-size: 8px;
    color: ${text-dim};             /* text-dim */
    background: transparent;
}

#ArcValue {
    font-family: "Consolas";
    font-size: 9px;
    color: ${text-secondary};             /* readout */
    background: transparent;
}

JoystickWidget {
    qproperty-baseEdgeColor: ${border-default};
    qproperty-baseDarkColor: ${bg-raised};
    qproperty-baseLightColor: ${bg-elevated};
    qproperty-baseGrooveColor: ${border-default};
    qproperty-glyphColor: ${text-muted};
    qproperty-handleEdgeColor: ${accent};
    qproperty-domeDarkColor: ${bg-header};
    qproperty-domeLightColor: ${bg-elevated};
}

ArcSliderWidget {
    qproperty-activeColor: ${accent};
    qproperty-inactiveTrackColor: ${text-dim};
    qproperty-thumbEdgeColor: ${bg-raised};
}

ArcSliderWidget[lensRole="zoom"] {
    qproperty-activeColor: ${negative-dim};
}

ArcSliderWidget[lensRole="focus"] {
    qproperty-activeColor: ${warning-border};
}

ArcSliderWidget[lensRole="iris"] {
    qproperty-activeColor: ${info};
}

/* === TCU Normal-mode DIST readout ======================= */
#TcuDistLabel {
    font-family: "Consolas";
    font-size: 10px;
    color: ${border-strong};             /* readout-dim */
    background: transparent;
}

UnlockBar {
    qproperty-trackBackgroundColor: ${bg-raised};
    qproperty-stripeColor: ${warning};
    qproperty-trackEdgeColor: ${border-default};
    qproperty-thumbLockedColor: ${bg-elevated};
    qproperty-thumbUnlockedColor: ${bg-elevated};
    qproperty-thumbEdgeArmedColor: ${border-strong};
    qproperty-thumbEdgePassColor: ${border-strong};
}

TimingBarWidget {
    qproperty-barBackgroundColor: ${bg-raised};
    qproperty-barTrackBackgroundColor: ${slider-track};
    qproperty-barTrackBorderColor: ${border-subtle};
    qproperty-barLabelColor: ${readout-dim};
    qproperty-barValueColor: ${text-secondary};
    qproperty-laserColor: ${info};
    qproperty-distanceColor: ${positive};
    qproperty-dovColor: ${warning};
    qproperty-mcpColor: ${negative};
    qproperty-barGradientStartFactor: 100;
    qproperty-barGradientEndFactor: 130;
}

/* === TCU Normal-mode FIRE LASER button =================== */
#FireLaserBtn {
    background-color: ${negative-bg};  /* negative-bg */
    color: ${negative};             /* negative */
    border: 1px solid ${negative-hover-bg};  /* negative-dim */
    border-radius: 3px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
}

#FireLaserBtn:hover {
    background-color: ${negative-hover-bg};
    color: ${negative-hover-text};
}

#FireLaserBtn:pressed,
#FireLaserBtn:checked {
    background-color: ${negative-active-bg};
    color: ${negative-active-text};
    border-color: ${negative};
}

#FireLaserBtn:disabled {
    background-color: ${negative-disabled-bg};
    color: ${negative-disabled-text};
    border-color: ${negative-disabled-border};
}

QPushButton[vidActive="true"] {
    background-color: ${positive-bg};
    color: ${positive};
    border-color: ${positive-border};
}

QPushButton[vidActive="true"]:hover {
    background-color: ${positive-hover-bg};
    color: ${positive-hover-text};
    border-color: ${positive-hover-border};
}
