/* ============================================================
 * GLI User Panel — Dark Theme (prototype v3)
 * Sprint 20: ports prototype.html :root tokens to QSS literals.
 * ============================================================
 *
 * Color tokens (prototype.html v3 :root)
 *
 * Surfaces
 *   bg-deepest    #040303    bg-base       #080707
 *   bg-raised     #12100E    bg-elevated   #1C1815
 *   bg-header     #261B14    bg-header-end #12100E
 *   bg-active     #2E221A
 *
 * Borders
 *   border-subtle #241E1A    border-default #382D25
 *   border-strong #8F6B4D
 *
 * Text
 *   text-primary   #F5E1CE   text-secondary #CDB299
 *   text-muted     #8A7461   text-dim       #5C4A3D
 *   text-ghost     #3D2E24
 *
 * Accent
 *   accent #E0924A   accent-muted #9E612B
 *   accent-glow-33 #E0924A55
 *
 * Semantic
 *   positive #00ff7f   negative #E6455D
 *   info     #4DA6E6   warning  #E6B345
 *   readout  #579972
 *
 * Misc
 *   slider-thumb #E0924A   slider-track #040303
 *   crosshair    #3cb371   shadow       #00000088
 * ============================================================ */

/* === Base ============================================== */
QMainWindow {
    background-color: #080707;
    color: #CDB299;
}

#Distance3DView {
    background-color: #080707;
    color: #CDB299;
}

/* Baseline rule for plain QWidget / QFrame instances (matches only
   exact class, not subclasses). Keeps re-parented .ui-designed
   QFrames (e.g. Preferences sub-groups) from showing the system
   palette through. Subclass-specific rules below override per id. */
.QWidget {
    background-color: #12100E;
    color: #CDB299;
}

.QFrame {
    background-color: #12100E;
    color: #CDB299;
}

/* === TopBar action cluster (preserved icon assets) ====== */
#NAME, #APP_NAME {
    image: url(:/title/GLI_dark);
}

#MIN_BTN::hover, #MAX_BTN::hover {
    background-color: #2E221A;
}

#MIN_BTN::pressed, #MAX_BTN::pressed {
    background-color: #382D25;
    border-style: none;
}

#EXIT_BTN::hover {
    background-color: #E6455D;
}

#EXIT_BTN::pressed {
    background-color: #992D3E;
}

#URL_BTN              { image: url(:/tools/dark/url); }
#URL_BTN::hover,
#URL_BTN::pressed     { image: url(:/tools/dark/url_hover); }

#SETTINGS_BTN         { image: url(:/tools/dark/settings); }
#SETTINGS_BTN::hover,
#SETTINGS_BTN::pressed{ image: url(:/tools/dark/settings_hover); }

#CAPTURE_BTN          { image: url(:/tools/dark/capture); }
#CAPTURE_BTN::hover,
#CAPTURE_BTN::pressed { image: url(:/tools/dark/capture_hover); }

#LANGUAGE_BTN         { image: url(:/tools/dark/lang); }

#CLS_BTN              { image: url(:/tools/dark/brush); }
#CLS_BTN::hover,
#CLS_BTN::pressed     { image: url(:/tools/dark/brush_hover); }

#THEME_BTN            { image: url(:/tools/toggle_dark); }
#THEME_BTN::hover,
#THEME_BTN::pressed   { image: url(:/tools/toggle_light); }

/* === Menus ============================================= */
QMenuBar, QMenu {
    background-color: #1C1815;
    color: #CDB299;
    border: 1px solid #382D25;
}

QMenuBar::item:selected, QMenu::selected {
    background-color: #2E221A;
    color: #F5E1CE;
}

/* === Inputs ============================================ */
QLineEdit, QTextEdit, QPlainTextEdit, .QComboBox, QDialog {
    border: 1px solid #241E1A;
    background-color: #080707;
    color: #579972;
    selection-background-color: #E0924A55;
    selection-color: #F5E1CE;
    border-radius: 2px;
}

QLineEdit::disabled, QTextEdit::disabled,
QPlainTextEdit::disabled, .QComboBox::disabled {
    background-color: #12100E;
    color: #5C4A3D;
}

QLineEdit::focus, QTextEdit::focus,
QPlainTextEdit::focus, .QComboBox::focus {
    border: 1px solid #E0924A55;
}

/* === ComboBox ========================================== */
.QComboBox::drop-down {
    image: url(:/tools/dark/triangle);
    width: 12px;
    height: 12px;
    margin-top: 2px;
    margin-left: 2px;
    background-color: #1C1815;
    border-radius: 2px;
}

.QComboBox::on {
    border: 1px solid #E0924A55;
}

.QComboBox::drop-down:disabled,
.QComboBox::drop-down:hover {
    background-color: #2E221A;
}

.QComboBox::drop-down:on {
    background-color: #382D25;
}

.QComboBox QAbstractItemView {
    background-color: #1C1815;
    selection-background-color: #2E221A;
    color: #CDB299;
    selection-color: #F5E1CE;
    border: 1px solid #382D25;
    border-radius: 2px;
    outline: 0px;
}

MiscSelection {
    border: none;
    background-color: #080707;
    color: #CDB299;
    width: 60px;
}

MiscSelection QAbstractItemView {
    background-color: #1C1815;
    selection-background-color: #2E221A;
    color: #CDB299;
    selection-color: #F5E1CE;
    border-radius: 2px;
    outline: 0px;
}

/* === Labels and frames ================================= */
.QLabel {
    color: #CDB299;
    background: transparent;
}

Display {
    border: 1px solid #382D25;
    background-color: #040303;
}

Ruler {
    color: #5C4A3D;
}

/* === Group box ========================================= */
/* Flat — matches plain-QFrame look used by the re-parented Preferences
   groups in SETUP overlay. Title remains as accent-colored label. */
QGroupBox {
    color: #F5E1CE;
    border: none;
    margin-top: 14px;
    padding-top: 0;
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    color: #E0924A;
    background: transparent;
    padding: 0 4px;
    font-weight: 700;
}

/* Setup overlay card titles — small labels above Save/Comm/TCU/Device cards.
   Color-only; weight intentionally normal to match how QGroupBox::title
   actually renders (its font-weight: 700 doesn't bold the subcontrol). */
#SETUP_CARD_TITLE {
    color: #E0924A;
    padding-left: 4px;
}

/* === Tabs ============================================== */
QTabWidget::pane {
    border: 1px solid #382D25;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #12100E;
}

QTabBar::tab {
    background-color: #12100E;
    color: #8A7461;
    width: 64px;
    height: 20px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border: 1px solid #241E1A;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #1C1815;
    color: #E0924A;
    border-color: #382D25;
}

QTabBar::tab:hover {
    background-color: #2E221A;
    color: #CDB299;
}

/* === Buttons =========================================== */
.QPushButton, .QToolButton {
    background-color: #12100E;
    color: #CDB299;
    border: 1px solid #382D25;
    border-radius: 2px;
    padding: 2px 6px;
}

.QPushButton::disabled, .QToolButton::disabled {
    background-color: #080707;
    border: 1px solid #241E1A;
    color: #5C4A3D;
}

.QPushButton::hover, .QToolButton::hover {
    background-color: #261B14;
    border: 1px solid #8F6B4D;
    color: #F5E1CE;
}

.QPushButton::pressed, .QToolButton::pressed {
    background-color: #2E221A;
    color: #E0924A;
}

.QPushButton:checked, .QToolButton:checked {
    background-color: #2E221A;
    border: 1px solid #E0924A;
    color: #E0924A;
}

QPushButton::menu-indicator {
    image: none;
}

/* === Checkbox / Radio (icon assets preserved) ========== */
.QCheckBox, .QRadioButton {
    color: #CDB299;
    background: transparent;
}

.QCheckBox::disabled, .QRadioButton::disabled {
    color: #5C4A3D;
}

.QCheckBox::indicator {
    width: 10px;
    height: 10px;
    border: 1px solid #382D25;
    background-color: #080707;
    border-radius: 2px;
}

.QRadioButton::indicator {
    width: 10px;
    height: 10px;
    border: 1px solid #382D25;
    background-color: #080707;
    border-radius: 7px;
}

.QCheckBox::indicator:checked   { image: url(:/tools/dark/check); }
.QRadioButton::indicator:checked{ image: url(:/tools/dark/dot); }

.QCheckBox::indicator:disabled,
.QRadioButton::indicator:disabled {
    background-color: #12100E;
    border-color: #241E1A;
}

.QCheckBox::indicator:hover,
.QRadioButton::indicator:hover {
    background-color: #1C1815;
    border-color: #8F6B4D;
}

.QCheckBox::indicator:pressed,
.QRadioButton::indicator:pressed {
    background-color: #040303;
}

/* === Slider ============================================ */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #040303;
    border: 1px solid #241E1A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #E0924A;
    border: 1px solid #8F6B4D;
    border-radius: 2px;
}

QSlider::handle:horizontal:hover {
    background-color: #F5A75D;
    border: 1px solid #E0924A;
}

QSlider::handle:horizontal:pressed {
    background-color: #9E612B;
}

QSlider::handle:horizontal:disabled {
    background-color: #5C4A3D;
    border: 1px solid #382D25;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #040303;
    border: 1px solid #241E1A;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #E0924A;
    border: 1px solid #8F6B4D;
    border-radius: 2px;
}

QSlider::handle:vertical:hover {
    background-color: #F5A75D;
}

#MCP_SLIDER::handle:horizontal,
#DELAY_SLIDER::handle:horizontal,
#GW_SLIDER::handle::horizontal,
#GAIN_SLIDER::handle:horizontal,
#PTZ_SPEED_SLIDER::handle:horizontal {
    width: 8px;
    height: 16px;
    margin-top: -6px;
    margin-bottom: -6px;
}

#BRIGHTNESS_SLIDER::handle:horizontal, #CONTRAST_SLIDER::handle:horizontal,
#GAMMA_SLIDER::handle:horizontal, #FOCUS_SPEED_SLIDER::handle:horizontal,
#SLIDER_SPEED_1::handle:horizontal, #SLIDER_SPEED_2::handle:horizontal,
#SLIDER_SPEED_3::handle:horizontal, #SLIDER_SPEED_4::handle:horizontal {
    width: 6px;
    height: 8px;
    margin-top: -2px;
    margin-bottom: -2px;
}

/* === Tools (display image overlay) ===================== */
Tools {
    background-color: #12100E;
    border: 1px solid #241E1A;
    border-radius: 2px;
}

#ZOOM_TOOL::indicator,
#SELECT_TOOL::indicator,
#PTZ_TOOL::indicator {
    width: 16px;
    height: 16px;
    /* QRadioButton anchors ::indicator left-of-text by default; with no
       text the indicator still hugs the left edge. Force center. */
    subcontrol-position: center;
}

#ZOOM_TOOL::indicator   { image: url(:/tools/dark/move); }
#SELECT_TOOL::indicator { image: url(:/tools/dark/select); }
#PTZ_TOOL::indicator    { image: url(:/tools/dark/ptz); }

Tools::checked { background-color: #2E221A; border-color: #E0924A55; }
Tools::hover   { background-color: #261B14; }

/* === Coordinate / info labels ========================== */
Coordinate InfoLabel {
    color: #F5E1CE;
}

/* === Spin box ========================================== */
QSpinBox {
    padding-right: 12px;
    border: 1px solid #241E1A;
    background-color: #080707;
    color: #579972;
    selection-background-color: #E0924A55;
    selection-color: #F5E1CE;
    border-radius: 2px;
}

QSpinBox::focus {
    border: 1px solid #E0924A55;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 12px;
    margin-right: 3px;
    image: url(:/tools/dark/up);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 12px;
    image: url(:/tools/dark/down);
    margin-right: 16px;
}

/* === Scroll area ======================================= */
QScrollArea, #CONTENT {
    border: none;
    background-color: #080707;
    color: #CDB299;
}

IndexLabel {
    color: #CDB299;
}

IndexLabel::hover {
    color: #F5E1CE;
    text-decoration: line-through;
}

#SCAN_CONFIG_BTN {
    background-color: transparent;
    border-style: none;
    image: url(:/tools/dark/settings_hover);
    padding: 2px;
}

#SCAN_CONFIG_BTN::hover, #SCAN_CONFIG_BTN::pressed {
    background-color: transparent;
    border-style: none;
    image: url(:/tools/dark/settings_hover);
    padding: 0px;
}

/* === ScrollBar ========================================= */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    padding: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    padding: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
    border-radius: 4px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #382D25;
    border: none;
    border-radius: 4px;
    min-height: 16px;
    min-width: 16px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    background: #8F6B4D;
}

QScrollBar::sub-line, QScrollBar::add-line {
    height: 0px;
    width: 0px;
    background: transparent;
}

/* === Aliasing / table view ============================= */
QTableView {
    background-color: #080707;
    color: #F5E1CE;
    border: 1px solid #382D25;
    gridline-color: #382D25;
    alternate-background-color: #12100E;
    selection-color: #F5E1CE;
    selection-background-color: #2E221A;
}

QTableView::item:!alternate:!selected {
    background-color: #080707;
}

QHeaderView::section {
    background-color: #1C1815;
    color: #E0924A;
    padding-left: 4px;
    border: 1px solid #382D25;
    min-height: 24px;
}

/* === Tooltip =========================================== */
QToolTip {
    background-color: #261B14;
    color: #F5E1CE;
    border: 1px solid #8F6B4D;
    padding: 2px 4px;
}

/* ============================================================
 * Sprint 20.2 — custom widgets
 * ============================================================ */

/* === TopBar shell ====================================== */
#TOP_BAR {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #261B14, stop:1 #1C1815);
    border-bottom: 1px solid #382D25;
}

/* TopButton — QPushButton subclass for the action cluster + window
   controls. The `image: url(...)` rules above place the icon; here we
   keep the button itself transparent + borderless so the icon shows
   on the TopBar gradient. (The legacy QSS had the equivalent rule
   under the now-removed TitleButton selector.) */
TopButton {
    background-color: transparent;
    border: none;
    padding: 0;
}

TopButton:hover {
    background-color: #2E221A;
}

TopButton:pressed {
    background-color: #382D25;
}

#TOP_BAR_LEFT, #TOP_BAR_CENTER, #TOP_BAR_RIGHT {
    background: transparent;
}

#TOP_BAR_CLOCK {
    color: #579972;
    font-family: Consolas;
    font-size: 11px;
    background: transparent;
}

#PIXEL_DEPTH_LABEL, #RESOLUTION_LABEL {
    color: #8A7461;
    background: transparent;
    font-size: 10px;
}

#SYSTEM_SELECTOR {
    background-color: #1C1815;
    color: #CDB299;
    border: 1px solid #382D25;
    border-radius: 2px;
    padding: 0 6px;
    min-height: 20px;
    max-height: 22px;
}

/* mode tabs (SETUP / MONITOR / SCAN) — checked state shows accent gradient */
#MODE_SETUP, #MODE_MONITOR, #MODE_SCAN {
    background-color: #1C1815;
    color: #5C4A3D;
    border: 1px solid #241E1A;
    padding: 3px 12px;
    font-weight: 700;
    font-size: 10px;
}

#MODE_SETUP:hover, #MODE_MONITOR:hover, #MODE_SCAN:hover {
    background-color: #2E221A;
    color: #CDB299;
}

#MODE_SETUP:checked, #MODE_MONITOR:checked, #MODE_SCAN:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #2E221A, stop:1 #1C1815);
    color: #E0924A;
    border: 1px solid #E0924A;
}

/* === FloatingPanel base ================================ */
#FloatingPanel {
    background-color: #12100E;
    border: 1px solid #382D25;
    border-radius: 3px;
}

#FloatingPanelHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #261B14, stop:1 #12100E);
    border-bottom: 1px solid #382D25;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

#FloatingPanelTitle {
    color: #E0924A;
    font-weight: 700;
    font-size: 10px;
    background: transparent;
    padding-left: 2px;
}

#FloatingPanelPin, #FloatingPanelHide, #FloatingPanelReset {
    background-color: transparent;
    color: #8A7461;
    border: none;
    border-radius: 2px;
    font-size: 9px;
}

#FloatingPanelPin:hover, #FloatingPanelHide:hover, #FloatingPanelReset:hover {
    background-color: #2E221A;
    color: #F5E1CE;
}

#FloatingPanelPin:checked {
    background-color: #2E221A;
    color: #E0924A;
}

#FloatingPanelHide:hover {
    background-color: #4D161E;
    color: #E6455D;
}

#PANORAMA_RESIZE_HANDLE {
    background-color: transparent;
    border-right: 2px solid #8A7461;
    border-bottom: 2px solid #8A7461;
}

#PANORAMA_RESIZE_HANDLE:hover {
    background-color: #2E221A;
    border-right: 2px solid #E0924A;
    border-bottom: 2px solid #E0924A;
}

#PANORAMA_STATUS {
    color: #8A7461;
    font-size: 9px;
    font-weight: 700;
    background: transparent;
    padding-right: 2px;
}

/* OpticsPanel / TCUPanel mode toggles — Classic/Modern, Normal/Guru */
#OPTICS_CLASSIC_BTN, #OPTICS_MODERN_BTN,
#TCU_NORMAL_BTN, #TCU_GURU_BTN {
    background-color: #12100E;
    color: #5C4A3D;
    border: 1px solid #241E1A;
    border-radius: 2px;
    padding: 2px 8px;
    font-size: 9px;
    font-weight: 700;
}

#OPTICS_CLASSIC_BTN:hover, #OPTICS_MODERN_BTN:hover,
#TCU_NORMAL_BTN:hover, #TCU_GURU_BTN:hover {
    background-color: #2E221A;
    color: #CDB299;
}

#OPTICS_CLASSIC_BTN:checked, #OPTICS_MODERN_BTN:checked,
#TCU_NORMAL_BTN:checked, #TCU_GURU_BTN:checked {
    background-color: #2E221A;
    color: #E0924A;
    border: 1px solid #E0924A;
}

/* === Center display toolbar (SEL / ZOOM / PTZ + INFO) === */
/* Transparent container so the chip-style Tools buttons sit cleanly over
   the display; the warm-border outline used to read cool/blue against the
   surrounding panels. Matches PANEL_TOGGLE_BAR. */
#CENTER_TOOLBAR {
    background: transparent;
    border: none;
}

/* === Pbar (panel-toggle bar) =========================== */
/* Transparent container so the buttons read as a chip cluster, not as a
   "box inserted into the panel". Each button still has its own border. */
#PANEL_TOGGLE_BAR {
    background: transparent;
    border: none;
}

#PBAR_OPTICS_BTN, #PBAR_TCU_BTN, #PBAR_CONSOLE_BTN {
    background-color: #12100E;
    color: #8A7461;
    border: 1px solid #241E1A;
    border-radius: 2px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

#PBAR_OPTICS_BTN:hover, #PBAR_TCU_BTN:hover, #PBAR_CONSOLE_BTN:hover {
    background-color: #2E221A;
    color: #CDB299;
}

#PBAR_OPTICS_BTN:checked, #PBAR_TCU_BTN:checked, #PBAR_CONSOLE_BTN:checked {
    background-color: #2E221A;
    color: #E0924A;
    border: 1px solid #E0924A;
}

/* === Right-side widget stack =========================== */
#RIGHT_STACK {
    background-color: #12100E;
    border: 1px solid #241E1A;
    border-radius: 3px;
}

#IMG_PROC_WIDGET, #PTZ_RADAR_WIDGET, #SAVE_OPTIONS_WIDGET, #VISION_WIDGET {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #241E1A;
}

#VISION_WIDGET { border-bottom: none; }

#VISION_ROW_MAIN, #VISION_ROW_ALT1, #VISION_ROW_ALT2 {
    background-color: transparent;
    border: none;
}

/* === Side zone (SideDisplay + Mapbox) ================== */
#SIDE_DISPLAY_WIDGET, #MAPBOX_WIDGET {
    background-color: #040303;
    border: 1px solid #241E1A;
    border-radius: 3px;
}

#SIDE_DISPLAY_PLACEHOLDER, #MAPBOX_PLACEHOLDER {
    color: #5C4A3D;
    background: transparent;
    font-size: 10px;
}

#SIDE_DISPLAY_SWAP_BTN {
    background-color: #1A1612;
    border: 1px solid #382D25;
    border-radius: 3px;
    padding: 0px;
}

#SIDE_DISPLAY_SWAP_BTN:hover {
    background-color: #2A2018;
    border-color: #5C4A3D;
}

#SIDE_DISPLAY_SWAP_BTN:pressed {
    background-color: #3A2C20;
}

/* === SETUP overlay ===================================== */
#SETUP_OVERLAY {
    background-color: #080707;
    border: none;
}

#SETUP_SCROLL {
    background-color: transparent;
    border: none;
}

#SETUP_ROW_1, #SETUP_ROW_2, #SETUP_ROW_3 {
    background-color: transparent;
}

#SETUP_PREVIEW_SIDEBAR {
    background-color: #12100E;
    border: 1px solid #241E1A;
    border-radius: 3px;
}

#SETUP_PREVIEW_PLACEHOLDER {
    color: #5C4A3D;
    background: transparent;
}

/* === SCAN overlay ====================================== */
#SCAN_OVERLAY {
    background-color: #080707;
    border: none;
}

#SCAN_SCROLL {
    background-color: transparent;
    border: none;
}

/* group cards */
#SCAN_CARD {
    background-color: #12100E;
    border: 1px solid #382D25;
    border-radius: 3px;
}

#SCAN_CARD_TTL {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #261B14, stop:1 #12100E);
    border-bottom: 1px solid #382D25;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-height: 22px;
    max-height: 22px;
}

#SCAN_CARD_TTL > QLabel {
    color: #E0924A;
    font-weight: 700;
    font-size: 10px;
    background: transparent;
}

#SCAN_CARD_BODY {
    background-color: #12100E;
    border: none;
}

/* Separator line inside scan card bodies — prototype `.guru-sep`.
   Replaces QFrame::HLine palette rendering with token-driven color. */
#SCAN_CARD_SEP {
    background-color: #261B14;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* action column — Start (positive) / Continue / Restart / Stop (negative) */
#SCAN_ACTION_COL {
    background-color: transparent;
}

#SCAN_ACTION_COL > QPushButton {
    background-color: #12100E;
    color: #8A7461;
    border: 1px solid #382D25;
    border-radius: 3px;
    padding: 6px 0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
}

#SCAN_ACTION_COL > QPushButton:hover {
    background-color: #261B14;
    color: #CDB299;
    border-color: #8F6B4D;
}

/* SCAN_BUTTON dual state — start (positive-green) vs running (warning-amber).
   The `scanning` dynamic property is set in userpanel.cpp's lambda hooked to
   ScanController::scan_button_text_changed. QSS attribute selectors pick up
   the value after unpolish + polish. */
#SCAN_ACTION_COL > #SCAN_BUTTON {
    background-color: #0b1b19;        /* positive-bg */
    color: #579972;                   /* readout */
    border: 1px solid #113c29;        /* positive-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON:hover {
    background-color: #10251e;        /* positive-hover-bg */
    color: #81e0a9;                   /* positive-hover-text */
    border: 1px solid #215c39;        /* positive-hover-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON[scanning="true"] {
    background-color: #33270F;        /* warning-bg */
    color: #EFC670;                   /* warning-hover-text */
    border: 1px solid #664E1E;        /* warning-border */
}

#SCAN_ACTION_COL > #SCAN_BUTTON[scanning="true"]:hover {
    background-color: #4D3B16;        /* warning-hover-bg */
    color: #E6B345;                   /* warning */
    border: 1px solid #806226;        /* warning-hover-border */
}

/* === SCAN preview sidebar ============================== */
#SCAN_PREVIEW_SIDEBAR {
    background-color: #12100E;
    border: 1px solid #241E1A;
    border-radius: 3px;
}

#SCAN_PREVIEW_PH {
    color: #5C4A3D;
    background: transparent;
}

/* === Modern PTZ labels (joystick + arc sliders) ======== */
#JoyLabel {
    font-size: 9px;
    color: #5C4A3D;             /* text-dim */
    background: transparent;
}

#ArcLabel {
    font-size: 8px;
    color: #5C4A3D;             /* text-dim */
    background: transparent;
}

#ArcValue {
    font-family: "Consolas";
    font-size: 9px;
    color: #CDB299;             /* readout */
    background: transparent;
}

/* === TCU Normal-mode DIST readout ======================= */
#TcuDistLabel {
    font-family: "Consolas";
    font-size: 10px;
    color: #8F6B4D;             /* readout-dim */
    background: transparent;
}

/* === TCU Normal-mode FIRE LASER button =================== */
#FireLaserBtn {
    background-color: #2A1217;  /* negative-bg */
    color: #E6455D;             /* negative */
    border: 1px solid #4D161E;  /* negative-dim */
    border-radius: 3px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
}

#FireLaserBtn:hover {
    background-color: #4D161E;
    color: #FF7589;
}

#FireLaserBtn:pressed,
#FireLaserBtn:checked {
    background-color: #6A1A23;
    color: #FFFFFF;
    border-color: #E6455D;
}

#FireLaserBtn:disabled {
    background-color: #1C0E10;
    color: #5C2A30;
    border-color: #2E1418;
}
